#include <WiFi.h>
#include <FirebaseESP32.h>

/* ---------- WiFi ---------- */
#define WIFI_SSID "Galaxy A16 5G"
#define WIFI_PASSWORD "muhil1234"

/* ---------- Firebase ---------- */
#define FIREBASE_HOST "voice-bot-6c096-default-rtdb.asia-southeast1.firebasedatabase.app"
#define FIREBASE_AUTH "gk3CzMll6u9kBPdengkP80crsToSaCV3AooWlEHR"

FirebaseData fbdo;
FirebaseConfig config;
FirebaseAuth auth;

/* ---------- L298N PINS ---------- */
#define IN1 26
#define IN2 27
#define ENA 25

#define IN3 14
#define IN4 12
#define ENB 33

/* ---------- PWM ---------- */
int speedPWM = 180;
String lastCommand = "";

/* ---------- SETUP ---------- */
void setup() {
  Serial.begin(115200);
  Serial.println("ESP32 STARTING...");

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // PWM setup (stable)
  ledcSetup(0, 1000, 8);
  ledcAttachPin(ENA, 0);

  ledcSetup(1, 1000, 8);
  ledcAttachPin(ENB, 1);

  stopCar();

  /* WiFi Connection */
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected");
  delay(2000); // 🔥 stability delay

  /* Firebase Setup */
  config.host = FIREBASE_HOST;
  config.signer.tokens.legacy_token = FIREBASE_AUTH;

  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  Serial.println("Firebase Ready");
}

/* ---------- LOOP ---------- */
void loop() {

  // Reconnect WiFi if lost
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Reconnecting WiFi...");
    WiFi.reconnect();
    delay(2000);
    return;
  }

  // 🔥 Firebase ready check (IMPORTANT)
  if (!Firebase.ready()) {
    Serial.println("Firebase not ready");
    delay(1000);
    return;
  }

  // Read command
  if (Firebase.getString(fbdo, "/robot/livedirection/direction")) {

    String command = fbdo.stringData();

    if (command != lastCommand) {
      Serial.println("New Command: " + command);

      if (command == "F") moveForward();
      else if (command == "B") moveBackward();
      else if (command == "L") turnLeft();
      else if (command == "R") turnRight();
      else if (command == "FL") turnLeftSmooth();
      else if (command == "FR") turnRightSmooth();
      else if (command == "S") stopCar();

      lastCommand = command;
    }

  } else {
    Serial.print("Firebase Error: ");
    Serial.println(fbdo.errorReason());
  }

  delay(1000); // 🔥 VERY IMPORTANT (prevents reset)
}

/* ---------- MOTOR FUNCTIONS ---------- */

void moveForward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  ledcWrite(0, speedPWM);
  ledcWrite(1, speedPWM);
}

void moveBackward() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  ledcWrite(0, speedPWM);
  ledcWrite(1, speedPWM);
}

void turnLeft() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  ledcWrite(0, speedPWM);
  ledcWrite(1, speedPWM);
}

void turnRight() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  ledcWrite(0, speedPWM);
  ledcWrite(1, speedPWM);
}

/* ---------- SMOOTH TURNS ---------- */

void turnLeftSmooth() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  ledcWrite(0, 100);
  ledcWrite(1, 200);
}

void turnRightSmooth() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  ledcWrite(0, 200);
  ledcWrite(1, 100);
}

void stopCar() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  ledcWrite(0, 0);
  ledcWrite(1, 0);
}
